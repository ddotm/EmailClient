<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IdempotentCookie.Email</AssemblyName>
    <RootNamespace>IdempotentCookie.Email</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>IdempotentCookie.Email</PackageId>
    <PackageTags>email, smtp, mailgun, sendgrid, office365, email-client, transactional-email</PackageTags>
    <PackageProjectUrl>https://github.com/ddotm/EmailClient</PackageProjectUrl>
    <Authors>Dmitri Mogilevski</Authors>
    <RepositoryUrl>https://github.com/ddotm/EmailClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Unified multi-provider email client for ASP.NET Core. Supports SMTP, Mailgun, SendGrid, and Office365.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>3.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSource>true</IncludeSource>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
  </ItemGroup>

</Project>
